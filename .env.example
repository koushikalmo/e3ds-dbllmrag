# Copy this file to .env and fill in your values. Never commit .env.

# MongoDB — the only two values you actually have to fill in
MONGODB_URI_STREAM=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI_APPCONFIGS=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

STREAM_DB_NAME=stream-datastore
APPCONFIGS_DB_NAME=appConfigs
DEFAULT_STREAM_COLLECTION=Apr_2026

# Ollama (install from https://ollama.com, then: ollama serve)
# Pull the model first: ollama pull qwen2.5-coder:7b
# 8GB GPU: qwen2.5-coder:7b / mistral:7b / llama3.1:8b
# 16GB GPU: qwen2.5-coder:14b is noticeably better
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Context window. The RAG prompt stays under ~2k tokens, so 8192 leaves
# plenty of room for the generated pipeline.
OLLAMA_NUM_CTX=8192

# Embedding model for RAG (ollama pull nomic-embed-text).
# Without it the app falls back to keyword search — works, just dumber.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Retries when the model produces invalid output. Each retry shows the
# model its own error so it can fix it.
LLM_MAX_RETRIES=3

# Server
HOST=0.0.0.0
PORT=8000

# Schema change-stream watcher (requires a replica-set / sharded cluster).
# Detects new/removed fields via MongoDB change streams and refreshes the
# schema cache at most once per COOLDOWN_SEC when drift is detected.
SCHEMA_WATCHER_ENABLED=1
SCHEMA_WATCHER_WAKE_SEC=60
SCHEMA_WATCHER_COOLDOWN_SEC=3600
