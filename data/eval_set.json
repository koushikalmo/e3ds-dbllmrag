    "question": "average load time on september 2025",
    "db_hint": "stream",
    "gold_pipeline": {
      "queryType": "single",
      "database": "stream-datastore",
      "collection": "Sep_2025",
      "operation": "aggregate",
      "pipeline": [
        {
          "$match": {
            "e3ds_employee": {
              "$ne": true
            }
          }
        },
        {
          "$group": {
            "_id": null,
            "totalLoadTime": {
              "$sum": "$loadTime"
            },
            "sessionCount": {
              "$sum": 1
            }
          }
        },
        {
          "$project": {
            "averageLoadTime": {
              "$divide": [
                "$totalLoadTime",
                "$sessionCount"
              ]
            }
          }
        },
        {
          "$limit": 50
        }
      ],
      "explanation": "Calculates the average load time in seconds for all sessions in September 2025.",
      "resultLabel": "Average Load Time"
    },
