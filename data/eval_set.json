    "id": "eval-auto-003",
    "question": "What is the average load time of each month of 2025",
    "db_hint": "stream",
    "gold_pipeline": {
      "queryType": "single",
      "database": "stream-datastore",
      "collection": "Jan_2025",
      "operation": "aggregate",
      "pipeline": [
        {
          "$match": {
            "e3ds_employee": {
              "$ne": true
