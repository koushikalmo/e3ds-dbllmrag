  {
    "id": "eval-auto-010",
    "question": "Give all users name and streaming time of april 16 2026.",
    "db_hint": "stream",
    "gold_pipeline": {
      "queryType": "single",
      "database": "stream-datastore",
      "collection": "Apr_2026",
      "operation": "aggregate",
      "pipeline": [
        {
          "$match": {
            "VideoStreamStartedAt_Timestamp": {
              "$gte": 1776384000000,
              "$lt": 1776470400000
            },
            "e3ds_employee": {
              "$ne": true
            }
          }
        },
        {
          "$group": {
            "_id": "$loggedInUserData.name",
            "userName": {
              "$first": "$loggedInUserData.name"
            },
            "sessionCount": {
              "$sum": 1
            },
            "totalMinutesStreamed": {
              "$sum": {
                "$divide": [
                  {
                    "$max": [
                      "$VideoStreamContinuedAt_Timestamp",
                      "$DataChannelHeartBeatReceivedAt_Timestamp"
                    ]
                  },
                  "$VideoStreamStartedAt_Timestamp"
                ]
              }
            }
          }
        },
        {
          "$limit": 50
        }
      ],
      "explanation": "Lists users and their streaming time on April 16, 2026",
      "resultLabel": "Users Streaming Time",
      "assumptions": [
        "Used Apr_2026 as the default collection because no month was specified"
      ],
      "confidence": "high"
    },
    "gold_result_shape": {
      "min_rows": 1,
      "max_rows": 200,
      "required_columns": [
